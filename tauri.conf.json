{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AzurPilot",
  "version": "3.0.4",
  "identifier": "moe.taiho.azurpilot",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AzurPilot",
        "width": 1280,
        "height": 880,
        "resizable": true,
        "additionalBrowserArgs": "--enable-features=msWebView2EnableDraggableRegions --disable-features=ElasticOverscroll,msWebOOUI,msPdfOOUI,msSmartScreenProtection --no-proxy-server --autoplay-policy=no-user-gesture-required",
        "url": "about:blank",
        "acceptFirstMouse": true,
        "visible": false,
        "create": false
      },
      {
        "label": "launcher",
        "title": "AzurPilot",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "decorations": false,
        "additionalBrowserArgs": "--enable-features=msWebView2EnableDraggableRegions --disable-features=ElasticOverscroll,msWebOOUI,msPdfOOUI,msSmartScreenProtection --no-proxy-server --autoplay-policy=no-user-gesture-required",
        "url": "index.html",
        "acceptFirstMouse": true,
        "visible": false,
        "create": true,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "frontend/dist"
  }
}
